{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "types": []
  },
  "include": [
    "src/components/**/*",
    "src/i18n/**/*"
  ],
  "exclude": [
    "src/example/**/*",
    "src/main.tsx",
    "vite.config.ts",
    "webpack.config.js",
    "node_modules",
    "dist"
  ]
}